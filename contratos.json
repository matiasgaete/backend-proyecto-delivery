{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "fastapiValidationError": {
      "type": "object",
      "required": ["detail"],
      "properties": {
        "detail": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["loc", "msg", "type"],
            "properties": {
              "loc": {
                "type": "array",
                "items": { "type": ["string", "integer"] }
              },
              "msg": { "type": "string" },
              "type": { "type": "string" }
            },
            "additionalProperties": true
          }
        }
      }
    },
    "httpError": {
      "type": "object",
      "required": ["detail"],
      "properties": {
        "detail": { "type": "string" }
      }
    }
  },
  "info": {
    "title": "Especificación Oficial de Contratos JSON - Sistema Delivery",
    "version": "1.0.0",
    "gateway_base_url": "http://localhost:8000/gateway"
  },
  "microservicios": {
    "usuarios": {
      "puerto_interno": 8005,
      "prefijo": "/usuarios",
      "contratos": [
        {
          "endpoint": "/gateway/usuarios/crear-usuario",
          "ruta_interna": "/usuarios/crear-usuario",
          "metodo": "POST",
          "request": {
            "headers": { "Content-Type": "application/json" },
            "body_dto": "crearUsuarioDTO",
            "schema": {
              "type": "object",
              "required": ["nombre", "apellido", "rut", "correo", "password"],
              "properties": {
                "nombre": { "type": "string" },
                "apellido": { "type": "string" },
                "rut": { "type": "string" },
                "correo": { "type": "string", "format": "email" },
                "password": { "type": "string", "format": "password" }
              }
            }
          },
          "response": {
            "status": 200,
            "schema": {
              "type": "object",
              "required": ["message"],
              "properties": {
                "message": { "type": "string", "const": "Usuario creado con exito" }
              }
            }
          },
          "error_responses": [
            {
              "status": 409,
              "description": "El usuario ya se encuentra registrado",
              "schema": { "$ref": "#/$defs/httpError" }
            },
            {
              "status": 422,
              "description": "Los datos del cuerpo no cumplen el formato esperado",
              "schema": { "$ref": "#/$defs/fastapiValidationError" }
            }
          ]
        },
        {
          "endpoint": "/gateway/usuarios/iniciar-sesion",
          "ruta_interna": "/usuarios/iniciar-sesion",
          "metodo": "POST",
          "request": {
            "headers": { "Content-Type": "application/json" },
            "body_dto": "iniciarSesionDTO",
            "schema": {
              "type": "object",
              "required": ["correo", "password"],
              "properties": {
                "correo": { "type": "string", "format": "email" },
                "password": { "type": "string", "format": "password" }
              }
            }
          },
          "response": {
            "status": 200,
            "schema": {
              "type": "object",
              "properties": {
                "id": { "type": "integer" },
                "nombre": { "type": "string" },
                "apellido": { "type": "string" },
                "rut": { "type": "string" },
                "correo": { "type": "string", "format": "email" },
                "pass_user": { "type": "string" },
                "creado_en": { "type": "string", "format": "date-time" }
              }
            }
          },
          "error_responses": [
            {
              "status": 401,
              "description": "Credenciales incorrectas",
              "schema": { "$ref": "#/$defs/httpError" }
            },
            {
              "status": 422,
              "description": "Los datos del cuerpo no cumplen el formato esperado",
              "schema": { "$ref": "#/$defs/fastapiValidationError" }
            }
          ]
        },
        {
          "endpoint": "/gateway/usuarios/solicitar-cambio",
          "ruta_interna": "/usuarios/solicitar-cambio",
          "metodo": "GET",
          "request": {
            "query_parameters": {
              "email": { "type": "string", "format": "email", "required": true }
            }
          },
          "response": {
            "status": 200,
            "schema": {
              "type": "object",
              "required": ["exito", "email"],
              "properties": {
                "exito": { "type": "boolean", "const": true },
                "email": { "type": "string", "format": "email" }
              }
            }
          },
          "error_responses": [
            {
              "status": 404,
              "description": "Usuario no encontrado",
              "schema": { "$ref": "#/$defs/httpError" }
            },
            {
              "status": 422,
              "description": "El correo no tiene un formato valido o falta el parametro",
              "schema": { "$ref": "#/$defs/fastapiValidationError" }
            }
          ]
        },
        {
          "endpoint": "/gateway/usuarios/cambiar-pass",
          "ruta_interna": "/usuarios/cambiar-pass",
          "metodo": "PUT",
          "request": {
            "headers": { "Content-Type": "application/json" },
            "body_dto": "cambiarPassDTO",
            "schema": {
              "type": "object",
              "required": ["correo", "new_pass"],
              "properties": {
                "correo": { "type": "string", "format": "email" },
                "new_pass": { "type": "string", "format": "password" }
              }
            }
          },
          "response": {
            "status": 200,
            "schema": {
              "type": "object",
              "required": ["message"],
              "properties": {
                "message": { "type": "string", "const": "Contraseña actualizada exitosamente" }
              }
            }
          },
          "error_responses": [
            {
              "status": 404,
              "description": "Usuario no encontrado",
              "schema": { "$ref": "#/$defs/httpError" }
            },
            {
              "status": 422,
              "description": "Los datos del cuerpo no cumplen el formato esperado",
              "schema": { "$ref": "#/$defs/fastapiValidationError" }
            }
          ]
        }
      ]
    },
    "entregas": {
      "puerto_interno": 8002,
      "prefijo": "/entregas",
      "contratos": [
        {
          "endpoint": "/gateway/entregas/entregas-id",
          "ruta_interna": "/entregas/entregas-id",
          "metodo": "GET",
          "request": {
            "query_dto": "getEntregasDTO",
            "query_parameters": {
              "ids_locales": { 
                "type": "array", 
                "items": { "type": "integer" }, 
                "required": true
              },
              "hora_peticion": { 
                "type": "string", 
                "format": "date-time", 
                "required": true
              },
              "app": {
                "type": "string",
                "default": "",
                "required": false
              }
            }
          },
          "response": {
            "status": 200,
            "schema": {
              "type": "object",
              "required": ["items"],
              "properties": {
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "rango_horario", "monto"],
                    "properties": {
                      "id": { "type": "integer" },
                      "rango_horario": { "type": "number" },
                      "monto": { "type": "integer" }
                    }
                  }
                }
              }
            }
          },
          "error_responses": [
            {
              "status": 422,
              "description": "Falta un parametro requerido o tiene un formato invalido",
              "schema": { "$ref": "#/$defs/fastapiValidationError" }
            }
          ]
        },
        {
          "endpoint": "/gateway/entregas/agregar-entrega",
          "ruta_interna": "/entregas/agregar-entrega",
          "metodo": "POST",
          "request": {
            "headers": { "Content-Type": "application/json" },
            "body_dto": "agregarEntregasDTO",
            "schema": {
              "type": "object",
              "required": ["hora_aceptacion", "hora_recogida", "hora_entrega", "monto", "id_local", "app"],
              "properties": {
                "hora_aceptacion": { "type": "string", "format": "date-time" },
                "hora_recogida": { "type": "string", "format": "date-time" },
                "hora_entrega": { "type": "string", "format": "date-time" },
                "monto": { "type": "integer" },
                "id_local": { "type": "integer" },
                "app": { "type": "string" }
              }
            }
          },
          "response": {
            "status": 200,
            "schema": {
              "type": "object",
              "required": ["message"],
              "properties": {
                "message": { "type": "string", "const": "Entrega registrada con exito" }
              }
            }
          },
          "error_responses": [
            {
              "status": 500,
              "description": "Error al registrar la entrega",
              "schema": { "$ref": "#/$defs/httpError" }
            },
            {
              "status": 422,
              "description": "Los datos del cuerpo no cumplen el formato esperado",
              "schema": { "$ref": "#/$defs/fastapiValidationError" }
            }
          ]
        }
      ]
    },
    "locales": {
      "puerto_interno": 8003,
      "prefijo": "/locales",
      "contratos": [
        {
          "endpoint": "/gateway/locales/consultar-locales",
          "ruta_interna": "/locales/consultar-locales",
          "metodo": "GET",
          "request": {
            "query_parameters": {
              "radio": { "type": "number", "format": "float", "required": true },
              "long": { "type": "number", "format": "float", "required": true },
              "lat": { "type": "number", "format": "float", "required": true }
            }
          },
          "response": {
            "status": 200,
            "schema": {
              "type": "object",
              "required": ["items"],
              "properties": {
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "nombre", "direccion"],
                    "properties": {
                      "id": { "type": "integer" },
                      "nombre": { "type": "string" },
                      "direccion": { "type": ["string", "null"] }
                    }
                  }
                }
              }
            }
          },
          "error_responses": [
            {
              "status": 422,
              "description": "Falta un parametro requerido o tiene un formato invalido",
              "schema": { "$ref": "#/$defs/fastapiValidationError" }
            }
          ]
        }
      ]
    },
    "rentabilidad": {
      "puerto_interno": 8001,
      "prefijo": "/rentabilidad",
      "contratos": [
        {
          "endpoint": "/gateway/rentabilidad/locales",
          "ruta_interna": "/rentabilidad/locales",
          "metodo": "GET",
          "request": {
            "query_parameters": {
              "lat": { "type": "number", "format": "float", "required": true },
              "long": { "type": "number", "format": "float", "required": true },
              "radio": { "type": "number", "format": "float", "required": true },
              "app": { "type": "string", "default": "", "required": false }
            }
          },
          "response": {
            "status": 200,
            "schema": {
              "type": "object",
              "required": ["items"],
              "properties": {
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "nombre", "direccion", "rentabilidad", "fiable"],
                    "properties": {
                      "id": { "type": "integer" },
                      "nombre": { "type": "string" },
                      "direccion": { "type": ["string", "null"] },
                      "rentabilidad": { "type": "number" },
                      "fiable": { "type": "boolean" }
                    }
                  }
                }
              }
            }
          },
          "error_responses": [
            {
              "status": 422,
              "description": "Falta un parametro requerido o tiene un formato invalido",
              "schema": { "$ref": "#/$defs/fastapiValidationError" }
            }
          ]
        }
      ]
    },
    "reportes": {
      "puerto_interno": 8004,
      "prefijo": "/reportes",
      "contratos": [
        {
          "endpoint": "/gateway/reportes/agregar-reporte",
          "ruta_interna": "/reportes/agregar-reporte",
          "metodo": "POST",
          "request": {
            "headers": { "Content-Type": "application/json" },
            "body_dto": "agregarReporteDTO",
            "schema": {
              "type": "object",
              "required": ["nombre_local", "direccion", "long", "lat", "titulo_reporte", "descripcion_reporte"],
              "properties": {
                "nombre_local": { "type": "string" },
                "direccion": { "type": "string" },
                "long": { "type": "number", "format": "float" },
                "lat": { "type": "number", "format": "float" },
                "titulo_reporte": { "type": "string" },
                "descripcion_reporte": { "type": "string" }
              }
            }
          },
          "response": {
            "status": 200,
            "schema": {
              "type": "object",
              "required": ["message"],
              "properties": {
                "message": { "type": "string", "const": "Reporte creado con exito" }
              }
            }
          },
          "error_responses": [
            {
              "status": 400,
              "description": "Error en el formato de entrada",
              "schema": { "$ref": "#/$defs/httpError" }
            },
            {
              "status": 422,
              "description": "Los datos del cuerpo no cumplen el formato esperado",
              "schema": { "$ref": "#/$defs/fastapiValidationError" }
            }
          ]
        },
        {
          "endpoint": "/gateway/reportes/consultar-reportes",
          "ruta_interna": "/reportes/consultar-reportes",
          "metodo": "GET",
          "request": {
            "query_parameters": {
              "lat": { "type": "number", "format": "float", "required": true },
              "long": { "type": "number", "format": "float", "required": true },
              "radio": { "type": "number", "format": "float", "required": true }
            }
          },
          "response": {
            "status": 200,
            "schema": {
              "type": "object",
              "required": ["items"],
              "properties": {
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "nombre_local", "direccion", "titulo_reporte", "descripcion_reporte", "creado_en", "long", "lat"],
                    "properties": {
                      "id": { "type": "integer" },
                      "nombre_local": { "type": "string" },
                      "direccion": { "type": "string" },
                      "titulo_reporte": { "type": "string" },
                      "descripcion_reporte": { "type": ["string", "null"] },
                      "creado_en": { "type": "string", "format": "date-time" },
                      "long": { "type": "number" },
                      "lat": { "type": "number" }
                    }
                  }
                }
              }
            }
          },
          "error_responses": [
            {
              "status": 422,
              "description": "Falta un parametro requerido o tiene un formato invalido",
              "schema": { "$ref": "#/$defs/fastapiValidationError" }
            }
          ]
        },
        {
          "endpoint": "/gateway/reportes/agregar-validacion",
          "ruta_interna": "/reportes/agregar-validacion",
          "metodo": "POST",
          "request": {
            "headers": { "Content-Type": "application/json" },
            "body_dto": "agregarValidacionDTO",
            "schema": {
              "type": "object",
              "required": ["id_reporte", "valido"],
              "properties": {
                "id_reporte": { "type": "integer" },
                "valido": { "type": "boolean" }
              }
            }
          },
          "response": {
            "status": 200,
            "schema": {
              "type": "object",
              "required": ["message"],
              "properties": {
                "message": { "type": "string", "const": "Validacion agregada con exito" }
              }
            }
          },
          "error_responses": [
            {
              "status": 404,
              "description": "Reporte no existente",
              "schema": { "$ref": "#/$defs/httpError" }
            },
            {
              "status": 422,
              "description": "Los datos del cuerpo no cumplen el formato esperado",
              "schema": { "$ref": "#/$defs/fastapiValidationError" }
            }
          ]
        }
      ]
    }
  }
}